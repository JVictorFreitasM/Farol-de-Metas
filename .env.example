DATABASE_URL="postgresql://user:password@localhost:5432/farol?schema=public"
PORT=3000

# OS-009-C: autenticação via IdP centralizado, substitui o login por senha próprio do Farol.
# idpUrl: chamado de dentro do container do backend (server-to-server). Se o IdP também rodar
# em Docker no host, use host.docker.internal; se rodar nativamente, ajuste conforme a rede.
IDP_URL="http://host.docker.internal:3000"
# authorizeUrl: usado só para montar os redirects que vão pro navegador do usuário — só
# precisa divergir de IDP_URL quando backend e navegador não enxergam o IdP pelo mesmo
# hostname/porta (ex.: container vs. localhost).
IDP_AUTHORIZE_URL="http://localhost:3000"
IDP_CLIENT_ID="change-me"
IDP_CLIENT_SECRET="change-me"
# Deve bater exatamente com o redirectUri cadastrado no painel do IdP para o Farol. Inclui
# o prefixo /api pois é o que o navegador de fato acessa (proxy do Vite).
IDP_REDIRECT_URI="http://localhost:5174/api/auth/callback"
FRONTEND_URL="http://localhost:5174"

SESSION_SECRET="change-me-in-production"
# false em dev (sem HTTPS local) — mudar para true quando houver certificado.
COOKIE_SECURE="false"

REDIS_URL="redis://redis:6379"
